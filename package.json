{
  "name": "motionlab",
  "private": true,
  "description": "MotionLab prototype: block programs compiled to a deterministic 2D physics simulation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node --check static/js/simulation.js && node scripts/record-fixture.js --check && node --test \"tests/*.test.js\"",
    "fixture:record": "node scripts/record-fixture.js",
    "fixture:check": "node scripts/record-fixture.js --check"
  }
}
